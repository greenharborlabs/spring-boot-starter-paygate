{
  "name": "paygate-wavelength-browser-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "test": "npm run check",
    "test:browser": "node test/browser-smoke.mjs",
    "test:unit": "npm run build:test && node --test --test-concurrency=1 build/test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lightninglabs/wavelength-web": "0.1.1",
    "farrier-kit": "1.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
