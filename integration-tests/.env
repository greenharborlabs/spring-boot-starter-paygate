# Integration test environment — configurable ports
# Override any of these to avoid conflicts with services on your host.

# bitcoind RPC port (regtest)
BITCOIND_RPC_PORT=18443

# LND gRPC port
LND_GRPC_PORT=10009

# LND REST port
LND_REST_PORT=18081

# Payer LND gRPC port (two-node LNbits proof stack)
LND_PAYER_GRPC_PORT=11009

# Payer LND REST port (two-node LNbits proof stack)
LND_PAYER_REST_PORT=18082

# LNbits HTTP port
LNBITS_PORT=15000

# Example app HTTP port
APP_PORT=18080
