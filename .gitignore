# Ignore Gradle build artifacts and cache
.gradle/
build/

# Keep planning and specification artifacts local-only.
plans/
specs/
# Ignore the entire specify directory and all its contents
.specify/
# Ignore generated local agent integrations
.agents/
# Ignore local Factory skill integrations
.factory/
# Ignore local orchestration resume checkpoints
.orchestrate/
# Ignore the entire claude directory and all its contents
.claude/
.vscode/

# IDE
.idea/
*.iml

# Eclipse / Buildship (compiled output + project metadata)
bin/
.project
.classpath
.settings/
**/src/main/java/**/*.class
**/src/test/java/**/*.class

# OS files
.DS_Store

# Secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# Local integration-test state (never release with production artifacts)
/integration-tests/.venv/
/integration-tests/.pytest_cache/
/integration-tests/**/__pycache__/
/integration-tests/.breez-spark-payer/
/integration-tests/.l402-credential.env
/reports/
